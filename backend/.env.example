# Server Configuration
PORT=5000
NODE_ENV=development
# Optional custom DNS servers (comma-separated). Defaults to Google & Cloudflare DNS (8.8.8.8, 8.8.4.4, 1.1.1.1) to resolve MongoDB Atlas SRV records
# DNS_SERVERS=8.8.8.8,8.8.4.4,1.1.1.1

# Frontend Client URL
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB Atlas)
# Replace with your MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/vibely?retryWrites=true&w=majority

# Google OAuth (Google Identity Services)
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Authentication Secrets
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary Configuration (Profile Picture Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

